{
  "name": "bank-project-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bank/web",
    "dev:web": "npm run dev --workspace=@bank/web",
    "dev:mobile": "npm run dev --workspace=@bank/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@bank/web",
    "build:mobile": "npm run build --workspace=@bank/mobile",
    "preview": "npm run preview --workspace=@bank/web",
    "cap:sync": "npm run cap:sync --workspace=@bank/mobile"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
