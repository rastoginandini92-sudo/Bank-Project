{
  "name": "bank-project-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bank/web",
    "dev:web": "npm run dev --workspace=@bank/web",
    "dev:mobile": "npm run dev --workspace=@bank/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@bank/web",
    "build:mobile": "npm run build --workspace=@bank/mobile",
    "preview": "npm run preview --workspace=@bank/web",
    "cap:sync": "cap sync",
    "icon:set": "node scripts/set-app-icon.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "firebase": "^12.19.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
